# Build
/build/
/cmake-build-*/

# ltlf-ek-bench's default JSON/xlsx output dir is /build/benchout/, already
# covered by /build/ above; this entry is only for a --out invoked with a
# different tree-relative scratch directory (docs/prd/benchmark-suite.md B1
# "Layer 2 -- timings... written to a gitignored output directory"). The
# committed snapshot goes under docs/runs/ instead, which is NOT ignored.
__pycache__/
*.pyc

# LaTeX aux
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
main.pdf

# CTest artifacts, written when ctest runs from the repo root rather than build/
/Testing/

# Agent worktrees (git worktree add roots).  Never `git add -A` while any
# exist --- see docs/prd/output-dependencies-tool.md's "Worktrees" loose end.
/.claude/worktrees/

# Editor / OS
.DS_Store
*.swp
*~
*.un~
compile_commands.json

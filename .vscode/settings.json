{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "cmake.configureSettings": {
    "SPOT_ROOT": "${userHome}/opt/spot-2.15.1"
  },
  "markdown.math.macros": {
    "\\Ifree": "\\mathcal{I}_{f}",
    "\\Iknown": "\\mathcal{I}_{k}",
    "\\Ofree": "\\mathcal{O}_{f}",
    "\\Oknown": "\\mathcal{O}_{k}",
    "\\Tin": "T_{\\mathit{Inp}}",
    "\\Tout": "T_{\\mathit{Out}}",
    "\\psiin": "\\psi_{\\mathit{Inp}}",
    "\\psiout": "\\psi_{\\mathit{Out}}",
    "\\Sin": "S_{\\mathit{Inp}}",
    "\\Sout": "S_{\\mathit{Out}}",
    "\\cons": "\\mathrm{cons}",
    "\\mirror": "\\widetilde{#1}",
    "\\rev": "#1^{\\mathrm{R}}",
    "\\Xdep": "\\mathcal{X}",
    "\\Ydep": "\\mathcal{Y}",
    "\\liveset": "R_{#1}"
  }
}
